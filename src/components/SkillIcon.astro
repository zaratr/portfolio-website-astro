  <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
    <rect width="48" height="48" rx="10" fill="#f0ede8"/>
    <text x="24" y="30" text-anchor="middle" font-size="16" font-weight="700" fill="#b8862b" font-family="sans-serif">
      {skill.charAt(0).toUpperCase()}
    </text>
  </svg>
)}
