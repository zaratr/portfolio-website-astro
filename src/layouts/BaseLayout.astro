---
// Base layout: <head>, <body>, animated background. Wraps every page.
interface Props {
  title: string;
  description?: string;
  robots?: string;        // 'index,follow' (landing) or 'noindex,nofollow' (role pages)
  ogImage?: string;
}

const {
  title,
  description = 'Raul Zarate — Production Engineer. Marine Corps mindset applied to reliable, scalable, secure software systems.',
  robots = 'index,follow',
  ogImage = '/images/og.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    {/* OpenGraph — link unfurls on LinkedIn / social */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />
  </head>
  <body>
    {/* Background: static circuit image (black traces on gray bg).
        Video animation deferred until content is locked. */}
    <div class="bg-circuit" aria-hidden="true"></div>

    <slot />
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  /* ─── Design tokens ─────────────────────────────────────────────── */
  :root {
    --color-bg-base:   #ffffff;
    --color-text:      #1a1410;
    --color-text-soft: #4a3f36;
    --color-text-dim:  #7a6f64;
    --color-accent:    #b8862b;
    --color-surface:   rgba(255, 252, 246, 0.94);
    --color-hairline:  rgba(26, 20, 16, 0.12);
    --radius-card:     18px;
    --ease-out-soft:   cubic-bezier(0.22, 1, 0.36, 1);
    --reveal-duration: 0.5s;
    --reveal-delay:   0.3s;
  }

  html, body { height: 100%; min-height: 100vh; }

  body {
    background: var(--color-bg-base);
    color: var(--color-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    position: relative;
    overflow-x: hidden;
  }

  /* ─── Background circuit ────────────────────────────────────────── */
  .bg-circuit {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 0;
    pointer-events: none;
    background-color: #ffffff;
    background-image: url('/images/bg-circuit.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
    }
  }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeDown { from { opacity: 0; transform: translate(-50%, -8px); } to { opacity: 1; transform: translate(-50%, 0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>
