---
// Landing page — thin digital business card.
// Public (index,follow). Three-card deck: Identity / Timeline / Certifications.
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';

const landingEntry = await getEntry('landing', 'landing');
const landing = landingEntry.data;
---

<BaseLayout
  title="Raul Zarate — Production Engineer"
  description="Production Engineer — a Marine Corps mindset applied to reliable, scalable, secure software systems. Focused on systems reliability, cloud infrastructure, and AI security."
  robots="index,follow"
>
  {/* Card-deck navigation — visible only when 2+ cards exist (handled by inline script) */}
  <nav class="navbar" aria-label="Cards" hidden>
    <button class="nav-btn" id="prevCard" aria-label="Previous card" disabled>‹</button>
    <div class="nav-dots" id="navDots"></div>
    <span class="nav-label" id="navLabel">1/3</span>
    <button class="nav-btn" id="nextCard" aria-label="Next card" disabled>›</button>
  </nav>

  <main class="stage">
    {/* Card deck — left column (first in DOM = left with space-between) */}
    <div class="card-deck" id="cardDeck">
      {/* Card 1: Identity */}
      <article class="card active" data-card="identity" data-title="Identity">
        <h1 class="name">{landing.name}</h1>
        <div class="rule" aria-hidden="true"></div>
        <p class="tagline" set:html={landing.positioningLine}></p>
        <p class="support" set:html={landing.intro}></p>
        <Contact email={landing.contact.email} github={landing.contact.github} phone={landing.contact.phone ?? ''} />
      </article>

      {/* Card 2: Timeline */}
      <article class="card" data-card="timeline" data-title="Timeline">
        <h2 class="card-title">Trajectory</h2>
        <div class="rule" aria-hidden="true"></div>
        <ol class="timeline">
          <li>
            <span class="t-when">Foundation</span>
            <span class="t-what">U.S. Marine Corps — mission-driven mindset: thriving under pressure, leading through complexity, delivering in high-stakes environments.</span>
          </li>
          <li>
            <span class="t-when">Education</span>
            <span class="t-what">B.S. Mathematics &amp; Statistics. Dual-track Master's work in Computer Science.</span>
          </li>
          <li>
            <span class="t-when">Recent — Wells Fargo</span>
            <span class="t-what">Owned production reliability for critical financial applications (C#, Java, Python, MS SQL Server). Led incident response and root-cause analysis, debugged concurrency / deadlocks / data corruption, optimized SQL, automated diagnostics. Zero-downtime operations in a regulated enterprise.</span>
          </li>
          <li>
            <span class="t-when">Now</span>
            <span class="t-what">Engineering at the intersection of systems reliability, cloud infrastructure, and AI security.</span>
          </li>
        </ol>
      </article>

      {/* Card 3: Certifications */}
      <article class="card" data-card="certs" data-title="Certifications">
        <h2 class="card-title">Certifications</h2>
        <div class="rule" aria-hidden="true"></div>
        <ul class="certs">
          <li><span class="cert-name">NVIDIA Certified Professional: Gen AI LLMs</span><span class="cert-meta">NVIDIA · Jun 2026</span></li>
          <li><span class="cert-name">CompTIA SecAI+ Certification</span><span class="cert-meta">CompTIA · Jun 2026</span></li>
          <li><span class="cert-name">CompTIA Security+ ce Certification</span><span class="cert-meta">CompTIA · Jun 2026</span></li>
          <li><span class="cert-name">PCEI™ — Certified Entry-Level AI Specialist with Python</span><span class="cert-meta">Python Institute · Jun 2026</span></li>
          <li><span class="cert-name">PCPP1 — Certified Professional Python Programmer Level 1</span><span class="cert-meta">Python Institute · Jun 2026</span></li>
          <li><span class="cert-name">Microsoft Certified: Azure Fundamentals</span><span class="cert-meta">Microsoft · Oct 2024</span></li>
          <li><span class="cert-name">Technical Support Fundamentals</span><span class="cert-meta">Google · Mar 2020</span></li>
        </ul>
      </article>
    </div>

    {/* Cutout figure — right column (second in DOM = right with space-between) */}
    <div class="figure" aria-hidden="true">
      <img src="/images/raul-best-3.png" alt="" />
    </div>
  </main>
</BaseLayout>

<script>
  // ─── Card deck navigation ──────────────────────────────────────────
  const deck = document.getElementById('cardDeck');
  const cards = Array.from(deck.querySelectorAll('.card'));
  const dotsContainer = document.getElementById('navDots');
  const label = document.getElementById('navLabel');
  const prevBtn = document.getElementById('prevCard');
  const nextBtn = document.getElementById('nextCard');
  let active = 0;

  // Show nav only when 2+ cards exist
  const navEl = document.querySelector('.navbar');
  if (cards.length > 1) navEl.hidden = false;

  // Build dots
  cards.forEach((c, i) => {
    const dot = document.createElement('button');
    dot.className = 'nav-dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('aria-label', `Card ${i+1}: ${c.dataset.title}`);
    dot.addEventListener('click', () => setActive(i));
    dotsContainer.appendChild(dot);
  });
  const dots = Array.from(dotsContainer.children);

  function setActive(i) {
    if (i < 0 || i >= cards.length) return;
    active = i;
    cards.forEach((c, idx) => c.classList.toggle('active', idx === i));
    dots.forEach((d, idx) => d.classList.toggle('active', idx === i));
    label.textContent = `${i+1}/${cards.length}`;
    prevBtn.disabled = i === 0;
    nextBtn.disabled = i === cards.length - 1;
  }

  prevBtn.addEventListener('click', () => setActive(active - 1));
  nextBtn.addEventListener('click', () => setActive(active + 1));

  // Keyboard nav
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  setActive(active - 1);
    if (e.key === 'ArrowRight') setActive(active + 1);
  });

  setActive(0);
</script>

<style>
  /* ─── Stage: cutout + card deck ────────────────────────────────────── */
  .stage {
    position: relative;
    z-index: 5;
    min-height: 100vh;
    max-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;  /* card hard-left, hero hard-right */
    gap: 0;
    padding: 88px 56px 56px;
    overflow: hidden;
  }

  /* Card deck — pinned left */
  .card-deck {
    position: relative;
    width: 100%;
    max-width: 480px;
    flex: 0 0 auto;
  }
  .card {
    background: rgba(255, 252, 246, 0.94);
    backdrop-filter: blur(20px) saturate(1.1);
    -webkit-backdrop-filter: blur(20px) saturate(1.1);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    box-shadow: 0 24px 64px rgba(60, 40, 20, 0.18), 0 2px 8px rgba(60,40,20,0.08);
    padding: 40px 44px;
    display: none;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
  }
  .card.active { display: block; }

  /* Identity card content */
  .name {
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    opacity: 0;
    animation: fadeUp var(--reveal-duration) var(--ease-out-soft) 0.3s forwards;
  }
  .rule {
    width: 40px; height: 1px;
    background: var(--color-accent);
    margin: 20px 0;
    opacity: 0;
    animation: fadeUp var(--reveal-duration) var(--ease-out-soft) 0.6s forwards;
  }
  .tagline {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.55;
    max-width: 36ch;
    opacity: 0;
    animation: fadeUp var(--reveal-duration) var(--ease-out-soft) 0.8s forwards;
  }
  .tagline :global(em) {
    font-style: normal;
    color: var(--color-accent);
    font-weight: 600;
  }
  .support {
    font-size: 13px;
    color: var(--color-text-soft);
    margin-top: 14px;
    line-height: 1.55;
    max-width: 40ch;
    opacity: 0;
    animation: fadeUp var(--reveal-duration) var(--ease-out-soft) 1.1s forwards;
  }

  /* Card titles (Timeline, Certifications) */
  .card-title {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
  }
  .card .rule { margin: 16px 0 24px; }

  /* Timeline */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .timeline li {
    padding-left: 20px;
    position: relative;
    line-height: 1.55;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px; height: 8px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(184, 134, 43, 0.14);
  }
  .timeline li::after {
    content: '';
    position: absolute;
    left: 3.5px;
    top: 18px;
    bottom: -22px;
    width: 1px;
    background: var(--color-hairline);
  }
  .timeline li:last-child::after { display: none; }
  .t-when {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: 4px;
  }
  .t-what {
    display: block;
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.55;
  }

  /* Certifications */
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .certs li {
    padding: 12px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: 10px;
    background: rgba(255, 252, 246, 0.5);
    transition: border-color 0.2s var(--ease-out-soft);
  }
  .certs li:hover { border-color: var(--color-accent); }
  .cert-name {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }
  .cert-meta {
    display: block;
    font-size: 11px;
    color: var(--color-text-dim);
    margin-top: 3px;
  }

  /* Cutout figure — pinned right */
  .figure {
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;        /* hero hugging right edge */
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    flex: 0 0 auto;
    animation: fadeIn var(--ease-out-soft) 1.2s 0.6s forwards;
  }
  .figure img {
    /* Hero sized by natural aspect ratio — capped to available stage height
       but never scaled up beyond natural size (avoids upsizing a small crop).
       No filter / drop-shadow / mask — image composites cleanly over bg. */
    height: auto;
    max-height: calc(100vh - 144px);
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  /* ─── Card-deck navbar ─────────────────────────────────────────────── */
  .navbar {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 10px;
    background: rgba(255, 252, 246, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    opacity: 0;
    animation: fadeDown var(--reveal-duration) var(--ease-out-soft) 0.2s forwards;
  }
  .nav-btn {
    width: 28px; height: 28px;
    border-radius: 999px;
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
    display: grid; place-items: center;
    transition: all 0.2s var(--ease-out-soft);
    font-size: 14px;
  }
  .nav-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .nav-btn:disabled { opacity: 0.3; cursor: default; }
  .nav-dots { display: flex; gap: 6px; }
  /* .nav-dot is created by JS at runtime — must be :global to escape Astro scope */
  :global(.nav-dot) {
    width: 8px; height: 8px;
    border-radius: 999px;
    background: var(--color-hairline);
    border: none; padding: 0;
    cursor: pointer;
    transition: background 0.2s var(--ease-out-soft), transform 0.2s var(--ease-out-soft);
  }
  :global(.nav-dot.active) {
    background: var(--color-accent);
    transform: scale(1.3);
  }
  .nav-label {
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
    min-width: 28px;
    text-align: center;
  }

  /* ═══ BREAKPOINTS ═══════════════════════════════════════════════════ */
  @media (min-width: 1920px) {
    .stage { padding-left: 96px; padding-right: 96px; }
    .card-deck { max-width: 560px; }
    .card { padding: 56px 52px; }
    .name { font-size: 40px; }
    .tagline { font-size: 18px; max-width: 40ch; }
    /* Hero still bounded by available stage height — never overflow */
    .figure img { max-height: calc(100vh - 144px); }
  }

  /* Tablet & mobile: hide hero, show card only. Side-by-side stops working
     below ~768px because there isn't room for both card (480px) + hero (500px). */
  @media (max-width: 900px) {
    .figure { display: none; }
    .stage {
      justify-content: center;        /* card centered when hero gone */
      padding: 88px 32px 88px;
      max-height: none;
      overflow: visible;
    }
    .card-deck { max-width: 540px; }
    .card { border-radius: 14px; }
  }

  @media (max-width: 540px) {
    .stage { padding: 80px 20px 80px; }
    .card { padding: 32px 24px; }
    .name { font-size: 26px; }
    .tagline { font-size: 14px; }
    .support { font-size: 12px; }
    .navbar { top: auto; bottom: 12px; max-width: calc(100% - 24px); }
  }

  @media (max-width: 360px) {
    .stage { padding: 72px 12px 72px; }
    .card { padding: 28px 16px; }
    .name { font-size: 24px; }
  }
</style>
