---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Raul Zarate" robots="noindex,nofollow">
  <main class="not-found">
    <div class="nf-content">
      <h1>404</h1>
      <p>This page doesn't exist.</p>
      <a href="/" class="nf-link">← Back to Home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    z-index: 5;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
  }
  .nf-content {
    text-align: center;
  }
  .nf-content h1 {
    font-size: 72px;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 8px;
    letter-spacing: -0.04em;
  }
  .nf-content p {
    font-size: 16px;
    color: var(--color-text-soft);
    margin-bottom: 24px;
  }
  .nf-link {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }
  .nf-link:hover { opacity: 0.7; }
</style>
